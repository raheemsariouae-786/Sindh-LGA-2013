<!DOCTYPE html>
<html lang="ur" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>قوانینِ بلدیات سندھ | لوکل گورنمنٹ ایکٹ 2013 اور رائٹ ٹو انفارمیشن 2016</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            background: #ffffff;
            font-family: 'Segoe UI', 'Poppins', 'Noto Nastaliq Urdu', 'Roboto', sans-serif;
            padding: 20px;
            min-height: 100vh;
            direction: rtl;
        }
        .legal-container {
            max-width: 1300px;
            margin: 0 auto;
            background: #ffffff;
            border-radius: 32px;
            padding: 24px 28px 45px;
            box-shadow: 0 8px 20px rgba(0,0,0,0.1);
            border: 1px solid #e0e0e0;
        }
        /* سرکاری ہیڈر */
        .legal-header {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            border-bottom: 4px solid #c9a03d;
            padding-bottom: 18px;
            margin-bottom: 30px;
        }
        .header-title h1 {
            font-size: 2.2rem;
            color: #2c5e2c;
            text-shadow: none;
        }
        .header-title p {
            color: #4a6e4a;
            font-size: 1rem;
        }
        .contact-info {
            background: #f5f2e6;
            padding: 12px 20px;
            border-radius: 30px;
            border: 1px solid #c9a03d;
            text-align: center;
        }
        .contact-info p {
            color: #2c5e2c;
            font-weight: bold;
            margin: 5px 0;
        }
        .contact-info span {
            direction: ltr;
            display: inline-block;
            font-size: 1.1rem;
        }
        .act-badge {
            background: #eef3e6;
            padding: 8px 20px;
            border-radius: 60px;
            border: 1px solid #c9a03d;
            font-weight: bold;
            color: #2c5e2c;
        }
        /* ٹیبز نیویگیشن */
        .tabs-nav {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 30px;
            border-bottom: 1px solid #ddd;
            padding-bottom: 8px;
        }
        .tab-btn {
            background: #f0f0f0;
            border: none;
            padding: 12px 26px;
            font-size: 1rem;
            font-weight: bold;
            border-radius: 50px;
            color: #2c5e2c;
            cursor: pointer;
            transition: 0.2s;
            font-family: inherit;
        }
        .tab-btn.active {
            background: #2c5e2c;
            color: white;
            box-shadow: 0 2px 8px rgba(0,0,0,0.2);
        }
        .tab-pane {
            display: none;
            animation: fade 0.2s ease;
        }
        .tab-pane.active-pane {
            display: block;
        }
        @keyframes fade {
            from { opacity: 0; transform: translateY(6px);}
            to { opacity: 1; transform: translateY(0);}
        }
        /* کارڈز */
        .legal-card {
            background: #fefef7;
            border-radius: 28px;
            border: 1px solid #e0d6b0;
            padding: 28px;
            margin-bottom: 28px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.05);
        }
        .section-title {
            font-size: 1.9rem;
            font-weight: bold;
            color: #2c5e2c;
            border-right: 6px solid #c9a03d;
            padding-right: 20px;
            margin-bottom: 25px;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .legal-text {
            background: #fafaf5;
            padding: 18px 24px;
            border-radius: 24px;
            line-height: 1.8;
            font-size: 1.05rem;
            margin: 15px 0;
            border-right: 4px solid #c9a03d;
            color: #1f2f1f;
        }
        .legal-text p, .legal-text li {
            margin-bottom: 10px;
        }
        .legal-text ul, .legal-text ol {
            margin-right: 30px;
            margin-top: 8px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin: 20px 0;
            background: #fefefe;
            border-radius: 20px;
            overflow: hidden;
        }
        th, td {
            border: 1px solid #ddd;
            padding: 12px;
            text-align: right;
            vertical-align: top;
        }
        th {
            background: #eef3e6;
            color: #2c5e2c;
        }
        hr {
            border-color: #ddd;
            margin: 18px 0;
        }
        footer {
            text-align: center;
            border-top: 1px solid #ddd;
            margin-top: 40px;
            padding-top: 20px;
            color: #5a6e5a;
            font-size: 0.9rem;
        }
        @media (max-width: 700px) {
            .legal-container { padding: 16px; }
            .section-title { font-size: 1.6rem; }
            .tab-btn { padding: 8px 18px; font-size: 0.9rem; }
            .legal-header { flex-direction: column; gap: 12px; align-items: stretch; }
            .contact-info { text-align: center; }
            .legal-text { font-size: 1rem; }
        }
        .highlight {
            color: #c9a03d;
            font-weight: bold;
        }
        .note-box {
            background: #f5f2e6;
            padding: 15px;
            border-radius: 24px;
            margin: 15px 0;
            border: 1px solid #e0d6b0;
        }
        .official-contact {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 20px;
            margin: 10px 0;
        }
    </style>
</head>
<body>
<div class="legal-container">
    <div class="legal-header">
        <div class="header-title">
            <h1>📜 قوانینِ بلدیات و اطلاعات</h1>
            <p>سندھ لوکل گورنمنٹ ایکٹ 2013 | رائٹ ٹو انفارمیشن ایکٹ 2016 | تمام ترامیم تا 2025</p>
        </div>
        <div class="contact-info">
            <p>🏢 سہراب گوٹھ ٹاؤن میونسپل کارپوریشن (ضلع شرقی، کراچی)</p>
            <p>📞 سرکاری نمبر: <span style="font-weight:bold; direction:ltr;">021-99334223</span></p>
            <p>📍 دفتر: سہراب گوٹھ، کراچی، سندھ</p>
        </div>
    </div>

    <!-- ٹیبز -->
    <div class="tabs-nav">
        <button class="tab-btn active" data-pane="paneLGAct">🏛️ لوکل گورنمنٹ ایکٹ 2013</button>
        <button class="tab-btn" data-pane="paneAmendments">📌 ترامیم (2021,2023,2025)</button>
        <button class="tab-btn" data-pane="paneRTI">📋 رائٹ ٹو انفارمیشن ایکٹ 2016</button>
        <button class="tab-btn" data-pane="paneRights">⚖️ شہری حقوق و احتساب</button>
    </div>

    <!-- پین 1: لوکل گورنمنٹ ایکٹ 2013 بنیادی دفعات -->
    <div id="paneLGAct" class="tab-pane active-pane">
        <div class="legal-card">
            <div class="section-title">📖 سندھ لوکل گورنمنٹ ایکٹ 2013 (ایکٹ نمبر XLII of 2013)</div>
            <div class="legal-text">
                <p><span class="highlight">🔹 تعارف:</span> یہ ایکٹ سندھ میں بلدیاتی اداروں کو جمہوری، خود مختار اور ذمہ دار بنانے کے لیے نافذ کیا گیا۔ اس کے تحت ٹاؤن کونسلز، ضلعی کونسلز اور میونسپل کارپوریشنز کے ڈھانچے، اختیارات اور ذمہ داریاں متعین کی گئیں۔</p>
                <p><span class="highlight">🔹 سیکشن 87-89: ٹاؤن کونسل کے فرائض</span><br>
                - صفائی، نکاسی آب، پانی کی فراہمی، سڑکیں، اسٹریٹ لائٹس، پارکس، فائر بریگیڈ، ٹریفک نظم و نسق۔<br>
                - تعلیمی اداروں، صحت مراکز، لائبریریوں کی دیکھ بھال۔<br>
                - ترقیاتی اسکیموں کی منظوری اور نگرانی۔</p>
                <p><span class="highlight">🔹 سیکشن 90: معائنہ (Inspection)</span><br>
                ہر مالی سال میں ٹاؤن کونسل کی کارکردگی کا معائنہ کیا جائے گا۔ چیئرمین رپورٹ پر عمل درآمد کو یقینی بنائیں گے۔</p>
                <p><span class="highlight">🔹 سیکشن 91: انکوائری (Inquiry)</span><br>
                حکومت سندھ کسی کونسلر یا کونسل کے معاملات کی انکوائری کر سکتی ہے۔</p>
                <p><span class="highlight">🔹 سیکشن 92: معطلی (Suspension)</span><br>
                اگر کوئی کونسلر یا کونسل غفلت کا شکار ہو تو گورنمنٹ انتظامیہ معطل کر سکتی ہے۔</p>
                <p><span class="highlight">🔹 سیکشن 93: تحلیل (Dissolution)</span><br>
                اگر کونسل مسلسل ناکام ہو تو گورنمنٹ 6 ماہ کے لیے تحلیل کر سکتی ہے، جس کے بعد نئے انتخابات ہوں گے۔</p>
                <p><span class="highlight">🔹 سیکشن 147: شکایات کا ازالہ</span><br>
                ٹاؤن آفیسر (شکایات) ہر شکایت کا 15 دن میں جواب دیں گے۔ اگر اطمینان نہ ہو تو پبلک احتساب کمیٹی میں اپیل کی جا سکتی ہے۔</p>
                <p><span class="highlight">🔹 شیڈیول II: بلدیاتی خدمات کی تفصیل</span><br>
                پانی کی فراہمی، گلیاں، نکاسی آب، اسٹریٹ لائٹس، پارکس، فائر بریگیڈ، ٹریفک نظم و نسق، آرٹ گیلریاں، لائبریریاں، قومی دنوں کی تقریبات، غیر ملکی مہمانوں کا استقبال، غیر قانونی قبضے ہٹانے کا اختیار۔</p>
                <p><span class="highlight">🔹 ریزرو نشستوں کا نظام (سیکشن 31, 32)</span><br>
                خواتین (33%)، نوجوان (5%)، لیبر (5%)، اقلیت (5%)، ٹرانس جینڈر (1%)، معذور (1%)۔ ہر ریزرو ممبر کو مکمل رائے دہی اور کمیٹیوں میں شمولیت کا حق ہے۔</p>
                <p><span class="highlight">🔹 قرارداد پاس کرنے کا طریقہ کار</span><br>
                کسی کونسلر کی تحریری قرارداد، چیئرمین کے ذریعے ایجنڈا میں شامل، عام اجلاس میں بحث، سادہ اکثریت (50%+1) سے منظور۔ منظور شدہ قرارداد چیف آفیسر ٹاؤن کو عملدرآمد کے لیے بھیجی جاتی ہے۔</p>
            </div>
        </div>
    </div>

    <!-- پین 2: ترامیم 2013 کے بعد -->
    <div id="paneAmendments" class="tab-pane">
        <div class="legal-card">
            <div class="section-title">📌 سندھ لوکل گورنمنٹ ایکٹ میں ترامیم (2013 تا 2025)</div>
            <div class="legal-text">
                <p><span class="highlight">✅ سندھ لوکل گورنمنٹ (ترمیم) ایکٹ 2021</span><br>
                - ٹرانس جینڈر اور معذور افراد کے لیے پہلی بار 1 فیصد ریزرو سیٹس کا اضافہ۔<br>
                - کراچی میئر کو سندھ سالڈ ویسٹ مینجمنٹ بورڈ کا چیئرمین اور واٹر بورڈ کا کو-چیئرمین مقرر کیا گیا۔<br>
                - بلدیاتی اداروں کے اختیارات میں توسیع۔</p>
                <p><span class="highlight">✅ سندھ لوکل گورنمنٹ (دوسری ترمیم) ایکٹ 2023</span><br>
                - میئر/چیئرمین کو اپنے علاقے میں تمام ڈیولپمنٹ اتھارٹیز (جیسے کے ڈی اے، ایل ڈی اے) کا چیئرمین مقرر کیا گیا۔<br>
                - کے ایم سی کو طبی اداروں (کے ایم سی ڈینٹل کالج، عباسی شہید ہسپتال، اسپینسر آئی ہسپتال وغیرہ) کا انتظامی کنٹرول واپس دیا گیا۔<br>
                - میئر کو واٹر بورڈ اور سالڈ ویسٹ مینجمنٹ بورڈ کے سی ای او کے لیے 3 نام تجویز کرنے کا اختیار۔<br>
                - کے ڈی اے، کے ڈبلیو ایس بی، ایس ایس ڈبلیو ایم بی کے چیئرمین میئر کراچی ہوں گے۔</p>
                <p><span class="highlight">✅ مجوزہ ترمیم 2025 (زیرِ غور)</span><br>
                - پیدائش کی رجسٹریشن لازمی بنانے کے لیے قانون میں ترمیم متوقع۔<br>
                - ایل جی ڈیپارٹمنٹ اور نادرا کے درمیان ڈیجیٹل ڈیٹا انٹری سسٹم کے ذریعے ہم آہنگی بہتر بنائی جائے گی۔<br>
                - تمام سرکاری و نجی اسپتالوں اور لیڈی ہیلتھ ورکرز سے ڈیٹا اکٹھا کیا جائے گا تاکہ شہریوں کی بنیادی سہولیات کو مانیٹر کیا جا سکے۔</p>
                <div class="note-box">
                    <p>⚠️ نوٹ: ان تمام ترامیم کے بعد ٹاؤن کونسلز کے اختیارات میں نمایاں اضافہ ہوا ہے۔ چیئرمین ٹاؤن کو اب ترقیاتی اسکیموں کی منظوری، ٹھیکیداروں کی نگرانی، اور بلدیاتی اداروں کے ساتھ مربوط فیصلہ سازی کا مکمل حق حاصل ہے۔</p>
                </div>
            </div>
        </div>
    </div>

    <!-- پین 3: رائٹ ٹو انفارمیشن ایکٹ 2016 -->
    <div id="paneRTI" class="tab-pane">
        <div class="legal-card">
            <div class="section-title">📋 سندھ ٹرانسپیرنسی اینڈ رائٹ ٹو انفارمیشن ایکٹ 2016</div>
            <div class="legal-text">
                <p><span class="highlight">🔹 قانون کا مقصد:</span> شہریوں کو سرکاری اداروں سے معلومات حاصل کرنے کا آئینی حق فراہم کرنا۔ یہ قانون آئین پاکستان کے آرٹیکل 19-A کے تحت نافذ کیا گیا۔</p>
                <p><span class="highlight">🔹 پبلک باڈی کی تعریف:</span> تمام سرکاری، نیم سرکاری، عدلیہ، بلدیاتی ادارے، اور وہ ادارے جو سرکاری فنڈز استعمال کرتے ہیں، سب اس قانون کے دائرے میں آتے ہیں۔</p>
                <p><span class="highlight">🔹 درخواست دینے کا طریقہ:</span> متعلقہ محکمے کے پبلک انفارمیشن آفیسر (PIO) کو تحریری درخواست دی جائے۔ درخواست اردو یا انگریزی میں ہو سکتی ہے۔</p>
                <p><span class="highlight">🔹 جواب کی مدت:</span> 15 دن کے اندر معلومات فراہم کی جائیں۔ اگر معلومات جان و مال کے تحفظ سے متعلق ہوں تو 3 دن میں جواب دیا جائے۔ 15 دن میں جواب نہ ملنے پر درخواست مسترد شدہ تصور ہوگی۔</p>
                <p><span class="highlight">🔹 مستثنیٰ معلومات:</span> صرف وہ معلومات جو قومی سلامتی، ذاتی رازداری، یا عدالتی کارروائی سے متعلق ہوں، روکی جا سکتی ہیں۔</p>
                <p><span class="highlight">🔹 سندھ انفارمیشن کمیشن:</span> اگر درخواست مسترد ہو یا جواب غیراطمینان بخش ہو تو 45 دن میں کمیشن میں اپیل کی جا سکتی ہے۔ کمیشن کا فیصلہ حتمی ہوتا ہے۔</p>
                <p><span class="highlight">🔹 جرمانہ (Penalty):</span> اگر پبلک انفارمیشن آفیسر بلاوجہ معلومات فراہم نہ کرے تو اس پر 10,000 روپے تک جرمانہ عائد کیا جا سکتا ہے۔</p>
                <p><span class="highlight">🔹 شہری کیسے استفادہ کر سکتے ہیں؟</span><br>
                - ٹاؤن کونسل کے اجلاسوں کی کارروائی (منٹس) حاصل کر سکتے ہیں۔<br>
                - ترقیاتی اسکیموں کے بجٹ اور اخراجات کی تفصیل طلب کر سکتے ہیں۔<br>
                - ٹھیکیداروں کے معاہدوں کی کاپی حاصل کر سکتے ہیں۔<br>
                - کونسلرز کے فنڈز کی تقسیم کی تفصیل معلوم کر سکتے ہیں۔<br>
                - سرکاری ملازمین کی تنخواہوں اور بھرتیوں کے بارے میں معلومات لے سکتے ہیں۔<br>
                - اگر کوئی عمارت بغیر نقشے کے بن رہی ہو تو اس کی اجازت نامے کی کاپی طلب کر سکتے ہیں۔</p>
                <div class="note-box">
                    <p>📢 <strong>آر ٹی آئی درخواست کا نمونہ:</strong> "محترم پبلک انفارمیشن آفیسر، سہراب گوٹھ ٹاؤن میونسپل کارپوریشن۔ موضوع: سال 2024-25 کے لیے سڑک کی تعمیر کے ٹھیکے کی تفصیلات اور اخراجات فراہم کریں۔" درخواست پر ڈاک ٹکٹ لگا کر یا ذیلی طور پر جمع کروائیں۔</p>
                </div>
            </div>
        </div>
    </div>

    <!-- پین 4: شہری حقوق و احتساب -->
    <div id="paneRights" class="tab-pane">
        <div class="legal-card">
            <div class="section-title">⚖️ شہری حقوق، احتساب اور قانونی راہنما</div>
            <div class="legal-text">
                <p><span class="highlight">📌 شہری کے بنیادی حقوق (قوانین کی روشنی میں)</span><br>
                - بلدیاتی خدمات (صفائی، پانی، سڑکیں) بروقت حاصل کرنے کا حق۔<br>
                - کونسلرز سے رابطہ کرنے اور ان سے کارکردگی کا جواب طلب کرنے کا حق۔<br>
                - ٹاؤن کونسل کے اجلاس میں بطور مبصر شرکت کا حق (سیکشن 58)۔<br>
                - شکایت درج کرانے اور 15 دن میں جواب حاصل کرنے کا حق۔<br>
                - آر ٹی آئی کے تحت معلومات حاصل کرنے کا حق۔</p>
                <p><span class="highlight">📌 احتساب کا طریقہ کار</span><br>
                ➤ اگر کوئی کونسلر یا ٹاؤن افسر غفلت برتے تو تحریری شکایت ٹاؤن آفیسر (شکایات) کو دیں۔<br>
                ➤ اگر 15 دن میں جواب نہ ملے تو پبلک احتساب کمیٹی (سیکشن 149) میں اپیل کریں۔<br>
                ➤ اگر کمیٹی بھی کارروائی نہ کرے تو سندھ انفارمیشن کمیشن یا متعلقہ ڈسٹرکٹ اینڈ سیشن جج کے پاس رجوع کریں۔<br>
                ➤ کونسلر کی غیر موجودگی یا عدم دلچسپی پر چیئرمین ٹاؤن کو آگاہ کریں۔</p>
                <p><span class="highlight">📌 کونسلرز کی ذمہ داریوں کی نگرانی کیسے کریں؟</span><br>
                - اپنے وارڈ کے کونسلر سے ماہانہ کارکردگی رپورٹ طلب کریں۔<br>
                - ٹاؤن کونسل کے اجلاسوں کی کارروائی آر ٹی آئی کے تحت حاصل کریں۔<br>
                - اگر کونسلر نے ترقیاتی فنڈز کا غلط استعمال کیا تو احتساب بیورو سندھ یا اینٹی کرپشن کو شکایت دیں۔</p>
                <div class="note-box">
                    <p>⚠️ یاد رکھیں: تمام کونسلرز (جنرل، خواتین، لیبر، نوجوان، اقلیت، ٹرانس جینڈر، معذور) عوام کے نمائندے ہیں۔ ان سے سوال پوچھنا اور جواب طلب کرنا آپ کا جمہوری حق ہے۔</p>
                    <p>📞 دفتری رابطہ: سہراب گوٹھ ٹاؤن میونسپل کارپوریشن کا سرکاری نمبر <strong>021-99334223</strong> ہے۔ آپ کسی بھی مسئلے، شکایت یا معلومات کے لیے اس نمبر پر صبح 9 سے شام 5 بجے تک رابطہ کر سکتے ہیں۔</p>
                </div>
            </div>
        </div>
    </div>

    <footer>
        © 2025 - محکمہ قانون، حکومت سندھ | سہراب گوٹھ ٹاؤن میونسپل کارپوریشن (ضلع شرقی) | تمام معلومات سرکاری دستاویزات اور قوانین سے ماخوذ ہیں۔
    </footer>
</div>

<script>
    // ٹیبز کا کام
    const btns = document.querySelectorAll('.tab-btn');
    const panes = document.querySelectorAll('.tab-pane');

    function switchPane(paneId) {
        panes.forEach(pane => pane.classList.remove('active-pane'));
        const active = document.getElementById(paneId);
        if (active) active.classList.add('active-pane');
        btns.forEach(btn => {
            btn.classList.remove('active');
            if (btn.getAttribute('data-pane') === paneId) btn.classList.add('active');
        });
    }

    btns.forEach(btn => {
        btn.addEventListener('click', function() {
            const target = this.getAttribute('data-pane');
            if (target) switchPane(target);
        });
    });

    // پہلے سے پہلا پین فعال
    if (!document.querySelector('.tab-pane.active-pane')) {
        document.getElementById('paneLGAct').classList.add('active-pane');
    }
</script>
</body>
</html>
