<!DOCTYPE html>
<html lang="ur" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<meta name="theme-color" content="#0a4a2e">
<title>Town Municipal Corporation Sohrab Goth | TMC Citizen Portal</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Noto+Nastaliq+Urdu:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
/* ══════════════════════════════════════════
   DESIGN SYSTEM — TMC SOHRAB GOTH PORTAL
   ══════════════════════════════════════════ */
:root{
  --G1:#052e18;--G2:#0a4a2e;--G3:#0d6e42;--G4:#1a9a5e;--G5:#e8f5ee;
  --Au:#c8a84b;--Al:#f0d080;--Aw:#fff8e6;
  --Wh:#ffffff;--Bg:#f0f4f2;--Bd:#c4d9cc;
  --Tx:#0d1f16;--Ts:#4a6b57;--Te:#94b8a4;
  --Re:#c0392b;--Bl:#1a5fb4;--Or:#e67e22;
  --Wa:#25d366;
  --sh:0 4px 24px rgba(5,46,24,.14);
  --sh2:0 8px 40px rgba(5,46,24,.22);
  --r:14px;--r2:8px;
  --fn:'Noto Nastaliq Urdu',serif;
  --tr:all .22s cubic-bezier(.4,0,.2,1);
}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html{scroll-behavior:smooth}
body{
  font-family:var(--fn);background:var(--Bg);color:var(--Tx);
  direction:rtl;min-height:100vh;font-size:15px;line-height:2;
  overflow-x:hidden;
}
a{color:inherit;text-decoration:none}
button{font-family:var(--fn);cursor:pointer;border:none;outline:none}
input,select,textarea{font-family:var(--fn);outline:none}

/* ══ SCROLLBAR ══ */
::-webkit-scrollbar{width:5px;height:5px}
::-webkit-scrollbar-track{background:#e0ede8}
::-webkit-scrollbar-thumb{background:var(--G3);border-radius:3px}
.logo-small{width:26px;height:26px;border-radius:50%;border:1px solid var(--Au);object-fit:contain;background:#fff;flex-shrink:0}


/* ══════════ HEADER ══════════ */
#pageHeader{
  background:linear-gradient(135deg,var(--G1) 0%,var(--G2) 45%,var(--G3) 100%);
  position:sticky;top:0;z-index:900;
  box-shadow:0 3px 20px rgba(0,0,0,.35);
}
.hdr-ribbon{
  background:var(--Au);
  display:flex;align-items:center;justify-content:center;gap:20px;
  padding:4px 16px;font-size:12px;color:var(--G1);font-weight:700;
  letter-spacing:.3px;flex-wrap:wrap;
}
.hdr-ribbon span::before{content:'● ';font-size:8px}
.hdr-body{
  display:flex;align-items:center;gap:12px;
  padding:10px 16px;
}
/* SVG Seal */
.hdr-seal{width:76px;height:76px;flex-shrink:0}
.hdr-center{flex:1;text-align:center;padding:0 4px}
.hdr-title1{
  font-size:21px;font-weight:700;color:var(--Al);
  text-shadow:0 2px 10px rgba(0,0,0,.5);line-height:1.4
}
.hdr-title2{font-size:13px;color:#b8dcc8;margin-top:2px}
.hdr-title3{font-size:11px;color:#8ab8a0;margin-top:1px}
.hdr-clock{
  background:rgba(0,0,0,.28);border-radius:10px;
  padding:8px 12px;text-align:center;flex-shrink:0;min-width:148px;
  border:1px solid rgba(200,168,75,.3);
}
.clk-time{font-size:22px;font-weight:700;color:var(--Al);
  font-variant-numeric:tabular-nums;letter-spacing:1px}
.clk-date{font-size:11.5px;color:#9dc8b0;margin-top:3px}
.clk-loc{font-size:10.5px;color:#7aaa90;margin-top:1px}

/* ══════════ NAV ══════════ */
#mainNav{
  background:var(--G1);border-top:2px solid var(--Au);
  overflow-x:auto;scrollbar-width:none;
}
#mainNav::-webkit-scrollbar{display:none}
.nav-ul{
  display:flex;list-style:none;
  flex-direction:row-reverse;min-width:max-content;
}
.nav-ul li a{
  display:flex;align-items:center;gap:5px;
  padding:11px 15px;color:#a8d8b8;font-size:13px;
  white-space:nowrap;border-bottom:3px solid transparent;
  transition:var(--tr);
}
.nav-ul li a:hover,.nav-ul li a.act{
  color:var(--Al);background:rgba(200,168,75,.1);
  border-bottom-color:var(--Au);
}
.nav-ul li a .ni{font-size:16px}

/* ══════════ LAYOUT ══════════ */
#appMain{max-width:860px;margin:0 auto;padding:18px 13px 120px}
.sec{display:none;animation:fadeUp .3s ease}
.sec.act{display:block}
@keyframes fadeUp{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}

/* ══════════ CARDS ══════════ */
.card{
  background:var(--Wh);border-radius:var(--r);
  box-shadow:var(--sh);border:1px solid var(--Bd);
  overflow:hidden;margin-bottom:18px;
}
.card-h{
  background:linear-gradient(100deg,var(--G1),var(--G3));
  color:var(--Wh);padding:13px 18px;
  display:flex;align-items:center;gap:10px;
  font-size:16px;font-weight:700;
  border-bottom:3px solid var(--Au);
}
.card-h .chi{font-size:20px}
.card-b{padding:18px}

/* ══════════ HERO BANNER ══════════ */
.hero{
  background:linear-gradient(135deg,var(--G1),var(--G3));
  border-radius:var(--r);padding:26px 20px;color:var(--Wh);
  text-align:center;margin-bottom:18px;position:relative;overflow:hidden;
  box-shadow:var(--sh2);border:2px solid rgba(200,168,75,.4);
}
.hero::before,.hero::after{
  content:'';position:absolute;border-radius:50%;
  background:rgba(200,168,75,.06);pointer-events:none;
}
.hero::before{width:220px;height:220px;top:-60px;right:-60px}
.hero::after{width:160px;height:160px;bottom:-50px;left:-30px}
.hero h2{font-size:19px;color:var(--Al);margin-bottom:8px;position:relative}
.hero p{font-size:13px;color:#b8dcc8;line-height:1.9;position:relative}
.stats-row{
  display:grid;grid-template-columns:repeat(3,1fr);
  gap:10px;margin-top:18px;position:relative;
}
.stat-box{
  background:rgba(255,255,255,.1);
  border:1px solid rgba(200,168,75,.35);
  border-radius:10px;padding:10px 8px;text-align:center;
}
.stat-n{font-size:26px;font-weight:700;color:var(--Al)}
.stat-l{font-size:12px;color:#9dc8b0;margin-top:2px}

/* ══════════ QUICK TILES ══════════ */
.tile-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:18px}
.tile{
  background:var(--Wh);border-radius:var(--r2);
  box-shadow:var(--sh);border:1px solid var(--Bd);
  padding:20px 14px;text-align:center;cursor:pointer;
  transition:var(--tr);
}
.tile:hover{transform:translateY(-3px);box-shadow:var(--sh2);border-color:var(--G4)}
.tile .ti{font-size:38px;display:block;margin-bottom:8px}
.tile .tl{font-size:14px;font-weight:700;color:var(--G1)}
.tile .ts{font-size:12px;color:var(--Ts);margin-top:3px}

/* ══════════ FORMS ══════════ */
.fg{margin-bottom:16px}
.fl{
  display:block;font-size:13px;font-weight:700;
  color:var(--G1);margin-bottom:6px;
}
.fl .req{color:var(--Re);margin-right:3px}
.fc{
  width:100%;padding:10px 13px;
  border:2px solid var(--Bd);border-radius:var(--r2);
  font-family:var(--fn);font-size:13px;color:var(--Tx);
  background:#fafffe;direction:rtl;transition:var(--tr);
}
.fc:focus{border-color:var(--G4);box-shadow:0 0 0 3px rgba(26,154,94,.15)}
textarea.fc{resize:vertical;min-height:90px}
select.fc{appearance:none;cursor:pointer}
.fc-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}

/* ══════════ COMPLAINT NUMBER BOX ══════════ */
.cn-box{
  background:linear-gradient(120deg,var(--G5),var(--Aw));
  border:2px dashed var(--Au);border-radius:10px;
  padding:14px 16px;text-align:center;margin-bottom:18px;
}
.cn-label{font-size:12px;color:var(--Ts);margin-bottom:4px}
.cn-val{
  font-size:22px;font-weight:700;color:var(--G1);
  font-family:monospace;letter-spacing:2px;
}
.cn-actions{display:flex;gap:8px;justify-content:center;margin-top:10px;flex-wrap:wrap}

/* ══════════ INFO ROW ══════════ */
.info-row{
  background:var(--G5);border-radius:var(--r2);
  padding:10px 14px;font-size:13px;
  display:flex;flex-wrap:wrap;gap:14px;margin-bottom:16px;
  border-right:4px solid var(--G3);
}
.info-row span{display:flex;align-items:center;gap:5px}

/* ══════════ BOXES ══════════ */
.box{border-radius:var(--r2);padding:13px 16px;margin-bottom:13px;border-right:5px solid}
.box.green{background:#e8f5ee;border-color:var(--G3)}
.box.gold{background:var(--Aw);border-color:var(--Au)}
.box.blue{background:#e8effc;border-color:var(--Bl)}
.box.red{background:#fdecea;border-color:var(--Re)}
.box.orange{background:#fef3e8;border-color:var(--Or)}
.box h4{font-size:14px;font-weight:700;margin-bottom:5px}
.box p,.box li{font-size:13px;line-height:1.9}

/* ══════════ LOCATION BOX ══════════ */
.loc-box{
  background:#edfbf3;border:2px solid #a8d8bc;
  border-radius:var(--r2);padding:10px 14px;
  font-size:13px;display:flex;align-items:center;
  gap:8px;flex-wrap:wrap;min-height:42px;margin-top:8px;
}
.loc-dot{
  width:10px;height:10px;border-radius:50%;
  background:var(--G4);flex-shrink:0;
  animation:lpulse 1.5s ease-in-out infinite;
}
@keyframes lpulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.4;transform:scale(1.5)}}

/* ══════════ CAMERA ══════════ */
.cam-wrap{margin-bottom:16px}
.cam-btns{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px}
.cam-video{
  width:100%;max-width:380px;height:230px;
  background:#000;border-radius:10px;display:none;
  object-fit:cover;border:3px solid var(--G3);margin:0 auto 10px;
  display:block;
}
#cameraFeed{display:none}
#captureCanvas{display:none}
.media-grid{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}
.media-thumb{
  width:78px;height:78px;object-fit:cover;
  border-radius:7px;border:2px solid var(--G4);
  cursor:pointer;transition:var(--tr);
}
.media-thumb:hover{transform:scale(1.05);border-color:var(--Au)}
.media-vthumb{
  width:78px;height:78px;object-fit:cover;
  border-radius:7px;border:2px solid var(--Re);
  cursor:pointer;
}
.rec-bar{
  display:none;align-items:center;gap:8px;
  background:#fdecea;border:2px solid var(--Re);
  border-radius:var(--r2);padding:8px 14px;
  font-size:13px;color:var(--Re);font-weight:700;
  margin-top:8px;
}
.rec-dot{
  width:12px;height:12px;border-radius:50%;
  background:var(--Re);animation:lpulse 1s infinite;
}
.media-counter{
  font-size:12px;color:var(--Ts);margin-top:6px;
  display:flex;gap:8px;flex-wrap:wrap;
}
.m-badge{
  background:var(--G3);color:#fff;
  border-radius:20px;padding:2px 10px;font-size:11px;
}

/* ══════════ BUTTONS ══════════ */
.btn{
  display:inline-flex;align-items:center;justify-content:center;
  gap:6px;padding:10px 18px;border-radius:var(--r2);
  font-family:var(--fn);font-size:13px;font-weight:600;
  transition:var(--tr);cursor:pointer;border:none;
}
.btn:active{transform:scale(.97)}
.btn-G{background:var(--G3);color:#fff}.btn-G:hover{background:var(--G1)}
.btn-Au{background:var(--Au);color:var(--G1)}.btn-Au:hover{background:#b8922e;color:#fff}
.btn-Wa{background:var(--Wa);color:#fff}.btn-Wa:hover{background:#128c3e}
.btn-Re{background:var(--Re);color:#fff}.btn-Re:hover{background:#922b21}
.btn-Out{background:transparent;border:2px solid var(--G3);color:var(--G3)}
.btn-Out:hover{background:var(--G5)}
.btn-Bl{background:var(--Bl);color:#fff}.btn-Bl:hover{background:#134a98}
.btn-sm{padding:7px 12px;font-size:12px}
.btn-lg{padding:14px 22px;font-size:15px}
.btn-block{width:100%}
.btn-row{display:flex;gap:10px;flex-wrap:wrap;margin-top:10px}

/* ══════════ SUBMIT ROW ══════════ */
.sub-grid{display:grid;gap:10px;margin-top:22px}
.sub-btn{
  display:flex;align-items:center;justify-content:center;gap:10px;
  padding:15px 20px;border-radius:10px;border:none;
  font-family:var(--fn);font-size:15px;font-weight:700;
  cursor:pointer;transition:var(--tr);width:100%;
}
.sub-btn:active{transform:scale(.98)}
.sub-portal{background:var(--G3);color:#fff}
.sub-portal:hover{background:var(--G1)}
.sub-wa{background:var(--Wa);color:#fff}
.sub-wa:hover{background:#128c3e}
.sub-both{background:linear-gradient(90deg,var(--Au),#b8922e);color:var(--G1)}
.sub-both:hover{filter:brightness(.9)}

/* ══════════ TABLE ══════════ */
.tbl{width:100%;border-collapse:collapse;font-size:13px}
.tbl th{
  background:var(--G1);color:#fff;
  padding:10px 12px;text-align:right;font-weight:600;
}
.tbl td{
  padding:9px 12px;border-bottom:1px solid #dceae2;
  vertical-align:top;
}
.tbl tr:nth-child(even) td{background:#f5faf7}
.tbl tr:hover td{background:var(--G5)}
.tbl a{color:var(--G3);font-weight:600}

/* ══════════ ACCORDION ══════════ */
.acc-item{
  border:1px solid var(--Bd);border-radius:var(--r2);
  margin-bottom:8px;overflow:hidden;
}
.acc-h{
  background:var(--G5);padding:12px 15px;cursor:pointer;
  display:flex;align-items:center;justify-content:space-between;
  font-weight:700;font-size:13px;user-select:none;transition:var(--tr);
}
.acc-h:hover{background:#d4eed8}
.acc-h .arr{transition:transform .2s;font-size:12px}
.acc-h.open .arr{transform:rotate(180deg)}
.acc-b{
  display:none;padding:14px 15px;font-size:13px;
  line-height:1.9;background:#fff;border-top:1px solid var(--Bd);
}
.acc-b.open{display:block}

/* ══════════ RIGHTS LIST ══════════ */
.rights-list{list-style:none}
.rights-list li{
  padding:13px 15px;border-bottom:1px solid var(--Bd);
  display:flex;align-items:flex-start;gap:12px;font-size:13px;
}
.rights-list li:last-child{border-bottom:none}
.ri{font-size:22px;flex-shrink:0;margin-top:2px}
.ri-title{font-weight:700;font-size:14px;color:var(--G1);display:block;margin-bottom:3px}
.ri-law{
  font-size:11px;color:var(--G4);background:var(--G5);
  border-radius:4px;padding:1px 6px;margin-top:4px;display:inline-block;
}

/* ══════════ STATUS TRACKER ══════════ */
.status-steps{
  display:flex;flex-direction:row-reverse;
  align-items:center;margin:18px 0;
  overflow-x:auto;padding-bottom:6px;
}
.step{text-align:center;min-width:70px}
.step-dot{
  width:30px;height:30px;border-radius:50%;
  border:3px solid var(--Bd);background:#fff;
  margin:0 auto 6px;display:flex;align-items:center;
  justify-content:center;font-size:14px;
}
.step.done .step-dot{background:var(--G4);border-color:var(--G4);color:#fff}
.step.active .step-dot{background:var(--Au);border-color:var(--Au);color:var(--G1)}
.step-line{flex:1;height:3px;background:var(--Bd);min-width:20px}
.step-line.done{background:var(--G4)}
.step-label{font-size:10px;color:var(--Ts)}

/* ══════════ BADGES ══════════ */
.badge{
  display:inline-block;padding:3px 10px;
  border-radius:20px;font-size:11px;font-weight:700;
}
.badge-new{background:#fff3cd;color:#856404}
.badge-prog{background:#cce5ff;color:#004085}
.badge-done{background:#d4edda;color:#155724}
.badge-urgent{background:#f8d7da;color:#721c24}

/* ══════════ RECENT COMPLAINTS ══════════ */
.rc-item{
  padding:12px 14px;border:1px solid var(--Bd);
  border-radius:var(--r2);margin-bottom:8px;
  background:#fafffe;transition:var(--tr);
}
.rc-item:hover{border-color:var(--G4);background:var(--G5)}
.rc-top{
  display:flex;justify-content:space-between;
  align-items:center;flex-wrap:wrap;gap:6px;margin-bottom:4px;
}
.rc-num{
  font-family:monospace;font-size:13px;
  font-weight:700;color:var(--G1);
}
.rc-info{font-size:12px;color:var(--Ts)}

/* ══════════ MODAL ══════════ */
.modal-ov{
  display:none;position:fixed;inset:0;
  background:rgba(0,0,0,.65);z-index:2000;
  align-items:center;justify-content:center;padding:16px;
}
.modal-ov.open{display:flex}
.modal-box{
  background:#fff;border-radius:16px;
  padding:28px 22px;max-width:400px;width:100%;
  text-align:center;box-shadow:0 12px 60px rgba(0,0,0,.35);
  animation:mpop .28s cubic-bezier(.34,1.56,.64,1);
}
@keyframes mpop{from{opacity:0;transform:scale(.8)}to{opacity:1;transform:scale(1)}}
.modal-icon{font-size:58px;margin-bottom:12px}
.modal-title{font-size:19px;font-weight:700;color:var(--G1);margin-bottom:8px}
.modal-num{
  font-size:21px;font-weight:700;color:var(--G4);
  letter-spacing:2px;font-family:monospace;
  background:var(--G5);border-radius:8px;
  padding:8px 16px;margin:10px 0;display:inline-block;
}
.modal-msg{font-size:13px;color:var(--Ts);line-height:1.9}

/* ══════════ TOAST ══════════ */
.toast{
  position:fixed;bottom:90px;right:50%;transform:translateX(50%);
  background:var(--G1);color:#fff;
  border-radius:30px;padding:10px 22px;
  font-size:13px;z-index:3000;
  box-shadow:0 6px 24px rgba(0,0,0,.3);
  opacity:0;pointer-events:none;
  transition:opacity .3s;
  border:1px solid var(--Au);
  white-space:nowrap;
}
.toast.show{opacity:1}

/* ══════════ FLOATING WA ══════════ */
.wa-float{
  position:fixed;bottom:22px;left:16px;z-index:1500;
}
.wa-float-btn{
  display:flex;align-items:center;gap:10px;
  background:var(--Wa);color:#fff;
  border-radius:50px;padding:12px 18px 12px 14px;
  font-size:13px;font-weight:700;
  box-shadow:0 5px 22px rgba(37,211,102,.45);
  transition:var(--tr);text-decoration:none;
  position:relative;
}
.wa-float-btn:hover{background:#128c3e;transform:translateY(-2px)}
.wa-float-icon{font-size:26px}
.wa-float-txt small{display:block;font-size:10.5px;opacity:.85}
.wa-pulse{
  position:absolute;top:-4px;right:-4px;
  width:15px;height:15px;border-radius:50%;
  background:var(--Re);animation:lpulse 1.5s infinite;
}

/* ══════════ EMERGENCY ══════════ */
.emer-bar{
  background:var(--Re);color:#fff;
  text-align:center;padding:6px 14px;font-size:12px;font-weight:700;
}
.emer-bar a{color:#ffd0d0}

/* ══════════ ADMIN PANEL ══════════ */
.admin-locked{
  text-align:center;padding:30px 20px;
}
.admin-icon{font-size:56px;margin-bottom:14px}

/* ══════════ COUNCILLOR CARD ══════════ */
.councillor-card{
  text-align:center;padding:24px 16px;
}
.coun-avatar{
  width:90px;height:90px;border-radius:50%;
  background:linear-gradient(135deg,var(--G3),var(--G1));
  margin:0 auto 14px;display:flex;align-items:center;
  justify-content:center;font-size:42px;
  border:4px solid var(--Au);
  box-shadow:0 4px 20px rgba(5,46,24,.25);
}
.coun-name{font-size:19px;font-weight:700;color:var(--G1)}
.coun-title{font-size:13px;color:var(--Ts);margin-top:3px}
.coun-quote{
  font-size:13px;color:#444;line-height:1.9;
  margin:14px 0;background:var(--G5);
  border-right:4px solid var(--Au);
  padding:12px 14px;border-radius:var(--r2);
  text-align:right;
}

/* ══════════ ANNOUNCEMENTS ══════════ */
.ann-item{
  padding:12px 14px;border-radius:var(--r2);
  border-right:5px solid;margin-bottom:10px;
  display:flex;gap:12px;align-items:flex-start;
}
.ann-icon{font-size:24px;flex-shrink:0}
.ann-content h4{font-size:14px;font-weight:700;margin-bottom:3px}
.ann-content p{font-size:12.5px;line-height:1.8}
.ann-content .ann-date{font-size:11px;color:var(--Ts);margin-top:4px}

/* ══════════ FOOTER ══════════ */
footer{
  background:var(--G1);color:#7aaa90;
  text-align:center;padding:22px 16px;
  border-top:3px solid var(--Au);
}
footer .f-title{font-size:15px;font-weight:700;color:var(--Al);margin-bottom:4px}
footer .f-sub{font-size:12px;margin-bottom:2px}
footer .f-copy{font-size:11px;color:#4a7a60;margin-top:8px}
footer a{color:var(--Al)}

/* ══════════ RTI TEMPLATE ══════════ */
.rti-tpl{
  background:#fffdf0;border:2px dashed var(--Au);
  border-radius:var(--r2);padding:16px;
  font-size:13px;line-height:2.2;
  white-space:pre-line;direction:rtl;
}

/* ══════════ CONTACT INFO ══════════ */
.contact-grid{
  display:grid;gap:10px;
}
.contact-item{
  display:flex;align-items:flex-start;gap:12px;
  padding:12px 14px;border-radius:var(--r2);
  background:var(--G5);border-right:4px solid var(--G3);
}
.contact-icon{font-size:22px;flex-shrink:0}
.contact-label{font-size:12px;color:var(--Ts);margin-bottom:2px}
.contact-val{font-size:14px;font-weight:700;color:var(--G1)}
.contact-val a{color:var(--G3)}

/* ══════════ SEARCH BOX ══════════ */
.search-box{
  display:flex;gap:8px;
}
.search-box .fc{border-radius:var(--r2) 0 0 var(--r2)}
.search-box .btn{border-radius:0 var(--r2) var(--r2) 0;flex-shrink:0}

/* ══════════ PRIORITY SELECTOR ══════════ */
.priority-sel{display:flex;gap:8px;flex-wrap:wrap}
.pri-opt{
  flex:1;min-width:80px;padding:9px 6px;
  border-radius:var(--r2);border:2px solid var(--Bd);
  text-align:center;cursor:pointer;font-size:13px;
  transition:var(--tr);background:#fff;
}
.pri-opt.sel-normal{border-color:var(--G4);background:var(--G5);color:var(--G1)}
.pri-opt.sel-urgent{border-color:var(--Or);background:#fef3e8;color:var(--Or)}
.pri-opt.sel-critical{border-color:var(--Re);background:#fdecea;color:var(--Re)}
.pri-opt input{display:none}

/* ══════════ PROGRESS BAR ══════════ */
.prog-bar{background:#e0ede8;border-radius:4px;height:8px;margin-top:6px}
.prog-fill{height:100%;border-radius:4px;background:var(--G4);transition:width .5s ease}

